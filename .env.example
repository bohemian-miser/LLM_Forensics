# Copy to .env (git-ignored). Loaded by `llmf` / `make` without overriding variables you
# already exported. Never commit real keys.

# Claude investigator (llm_forensics/investigator). Leave empty to skip those steps,
# or set LLMF_INVESTIGATOR_DRY_RUN=1 to use the scripted offline agent.
ANTHROPIC_API_KEY=

# Only for gated Hugging Face models (Llama/Gemma). Llama/Mistral are also available
# without a token via scripts/fetch_gcs_model.py; Qwen/OLMo/GPT-J/Mistral are ungated.
HF_TOKEN=

# Force a device for every step (default: cuda if nvidia-smi works, else cpu)
# LLMF_DEVICE=cuda

# SaladCloud settings live OUTSIDE the repo in ~/.config/llm_forensics/salad.env:
#   SALAD_API_KEY=...   SALAD_ORG=bohemian-miser   SALAD_PROJECT=default
