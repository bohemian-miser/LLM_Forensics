# Copy to .env (git-ignored). Loaded by `python -m lab` and `make` without overriding variables
# you already exported. `llmf` itself reads keys from the environment or ~/.config/llm_forensics/<provider>.env.
# Never commit real keys.

# LLM investigators: one llm-<provider> detector per key. Leave a key empty to skip that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Only for gated Hugging Face models (Llama, Gemma 2/3). Llama is also available without a token
# through scripts/fetch_gcs_model.py; Qwen, OLMo, GPT-J and Mistral are ungated.
HF_TOKEN=

# Device for every lab step (default: cuda if nvidia-smi works, else cpu)
# LLMF_DEVICE=cuda

# SaladCloud settings live outside the repo in ~/.config/llm_forensics/salad.env:
#   SALAD_API_KEY=...   SALAD_ORG=bohemian-miser   SALAD_PROJECT=default
